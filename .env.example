# Copie para .env (cp .env.example .env) e troque os valores.
# O arquivo .env NAO e versionado. Valores abaixo sao ficticios.

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/sheetplayer
DB_USERNAME=sheetplayer
DB_PASSWORD=troque-esta-senha

# --- Container PostgreSQL (docker-compose.yml) ---
DB_NAME=sheetplayer

# --- Login (JWT) ---
# Chave que assina o token de acesso: pelo menos 32 bytes. A API NAO sobe sem ela.
# Fica vazia de proposito: um valor de exemplo copiado sem trocar seria uma chave publica,
# e qualquer um forjaria tokens. Gere a sua com: openssl rand -base64 48
JWT_SEGREDO=

# --- Producao (2.6, Render + Neon): estas variaveis sao definidas no painel do Render, nao num arquivo ---
# DB_URL = endpoint DIRETO do Neon (nao o pooler), com sslmode=require. Exemplo ficticio:
#   DB_URL=jdbc:postgresql://ep-exemplo.us-east-1.aws.neon.tech/fichas?sslmode=require
# APP_CORS_ORIGENS: origens do front, separadas por virgula
APP_CORS_ORIGENS=https://fichas-rpg.pages.dev
# Liga o POST /auth/demo (a conta de demonstracao). Sem isto a rota responde 404.
SPRING_PROFILES_ACTIVE=demo
# Nao registrar todo SQL
LOGGING_LEVEL_ORG_HIBERNATE_SQL=info
# Padrao da imagem (Dockerfile), para 512 MB e 0,1 CPU
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k
